# Ludwitt OAuth — register at https://www.ludwitt.com/learning-engineers/apps/new
LUDWITT_CLIENT_ID=
LUDWITT_CLIENT_SECRET=
LUDWITT_BASE_URL=https://www.ludwitt.com
LUDWITT_SCOPES=profile credits:read credits:spend data:read data:write
LUDWITT_AI_MODEL=claude-haiku-4-5

# Local development
LUDWITT_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Production (Render) — example values after deploy
# LUDWITT_REDIRECT_URI=https://quickquiz-api.onrender.com/auth/callback
# FRONTEND_URL=https://quickquiz.vercel.app
# COOKIE_SECURE=true

# App security
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: extra CORS origins (comma-separated)
# CORS_ORIGINS=https://quickquiz.vercel.app

# Legacy CLI / Streamlit only
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
ECONOMY_COST_PER_CALL=0.002
